# Copy to .env and fill in.
# Shared PIN the team types once on their phone.
TEAM_PIN=change-me
# PIN for the admin dashboard (/porters/admin.html): upload, edit, assign porters, history.
ADMIN_PIN=change-me-too
# Name shown on ticks and uploads made from the dashboard (default: Admin).
# ADMIN_NAME=
# Starting list of porters (first run only - after that, manage them in the admin dashboard).
PORTERS=Tom,Jeet,Robinson,Pablo,Ricardo,Wilson
# Optional
# PORT=3000
# VAPID_SUBJECT=https://zetahub.co.uk/porters/   (contact address sent with push notifications)
# TIME_ZONE=Europe/London   (decides which day is "today" in a multi-day sheet file)
# Read screenshots with Claude instead of the free OCR (costs a few pence per upload):
# EXTRACT_ENGINE=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
