{
  "name": "porters-agenda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first daily agenda for the porters team. Reads the daily sheet screenshot (free OCR) or the sheet file.",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "mock": "node --disable-warning=ExperimentalWarning --watch server.js --mock"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0"
  }
}
